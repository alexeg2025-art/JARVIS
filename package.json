{
  "name": "jarvis-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "A refined desktop AI assistant inspired by JARVIS.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc -b && vite build && tsc -p electron/tsconfig.json",
    "start": "electron .",
    "preview": "vite preview"
  },
  "dependencies": { "lucide-react": "^0.468.0", "react": "^18.3.1", "react-dom": "^18.3.1" },
  "devDependencies": { "@types/node": "^22.10.2", "@types/react": "^18.3.12", "@types/react-dom": "^18.3.1", "@vitejs/plugin-react": "^4.3.4", "autoprefixer": "^10.4.20", "concurrently": "^9.1.0", "cross-env": "^7.0.3", "electron": "^33.2.1", "postcss": "^8.4.49", "tailwindcss": "^3.4.16", "typescript": "~5.7.2", "vite": "^6.0.5", "wait-on": "^8.0.1" }
}
